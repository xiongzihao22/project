{
  "status": "experimental_baseline_not_reported_by_thesis",
  "seed": 13,
  "model_config": "configs/hdit_candidate.json",
  "image_size": 512,
  "batch_size": 4,
  "num_workers": 4,
  "precision": "bfloat16",
  "gradient_checkpointing": true,
  "augmentation": "none",
  "sigma": {
    "minimum": 0.02,
    "maximum": 20.0,
    "data": 0.5,
    "log_normal_mean": -1.2,
    "log_normal_std": 1.2
  },
  "loss": {
    "reduction": "pixel_mean",
    "weighting": "edm"
  },
  "optimizer": {
    "type": "AdamW",
    "learning_rate": 0.0001,
    "betas": [0.9, 0.999],
    "weight_decay": 0.0
  },
  "learning_rate_schedule": "constant",
  "gradient_clipping": null,
  "maximum_steps": 100,
  "checkpoint_interval": 50,
  "sample_steps": [0, 50, 100]
}
